{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "server.ts"
  ],
  "exclude": [
    "src/test.ts",
    "src/**/*.spec.ts",
    "**/*.stories.ts",
    "src/app/helpers/tests/spies.ts",
    "src/app/modules/shared/utils/helpers/spies.ts",
    "**/*.spies.ts"
  ]
}
